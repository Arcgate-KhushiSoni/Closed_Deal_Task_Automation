{
  "manifest_version": 3,
  "name": "Compass - Closed Deals",
  "version": "1.0.0",
  "description": "Automate adding closed deals to Compass agent profiles via Excel import",
  "permissions": ["tabs", "activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["*://www.compass.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.compass.com/internal/agent-profile-editor/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
